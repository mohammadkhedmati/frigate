# فایل پیکربندی Frigate
# برای اطلاعات بیشتر: https://docs.frigate.video/

mqtt:
  enabled: true
  host: mqtt
  port: 1883
  # user: username  # اختیاری
  # password: password  # اختیاری

# تنظیمات TLS - غیرفعال کردن HTTPS برای محیط توسعه
tls:
  enabled: false

# تنظیمات احراز هویت (Authentication)
# با فعال‌سازی این بخش، کاربران باید وارد شوند تا از Frigate استفاده کنند
auth:
  enabled: true
  # reset_admin_password: false  # اگر رمز admin را فراموش کردید، این را true کنید و Frigate را restart کنید

  # تنظیمات detectors (پردازشگرهای تشخیص اشیا)
  # برای استفاده از GPU، ابتدا nvidia-container-toolkit را نصب کنید
  # سپس در docker-compose.yml بخش deploy را uncomment کنید
  roles:
    editor:
      - entry
detectors:
  cpu:
    type: cpu
    num_threads: 3
  # برای استفاده از GPU (بعد از نصب nvidia-container-toolkit):
  # onnx:
  #   type: onnx
  #   device: GPU

# مدل پیش‌فرض برای تشخیص اشیا
model:
  width: 320
  height: 320

# تنظیمات ffmpeg برای استفاده از GPU NVIDIA
# ffmpeg:
#   hwaccel_args: preset-nvidia-h264

# تنظیمات ضبط
record:
  enabled: true
  alerts:
    retain:
      days: 10
  detections:
    retain:
      days: 10
  continuous:
    days: 0
  motion:
    days: 7
snapshots:
  enabled: true
  retain:
    default: 10 # نگهداری عکس‌ها به مدت 10 روز

# تنظیمات دوربین‌ها
cameras:
  # دوربین نمونه - این را با اطلاعات دوربین‌های خودتان جایگزین کنید
  room1:
    enabled: true
    ffmpeg:
      inputs:
        - path: rtsp://admin:admin1234@192.168.100.113:554/cam/realmonitor?channel=1&subtype=1
          roles:
            - detect
            - rtmp
    detect:
      width: 1920
      height: 1080
      fps: 15
      enabled: true
    notifications:
      enabled: true
  room2:
    enabled: true
    ffmpeg:
      inputs:
        - path: rtsp://admin:admin1234@192.168.100.114:554/cam/realmonitor?channel=1&subtype=1
          roles:
            - detect
            - rtmp
    detect:
      width: 1920
      height: 1080
      fps: 15
      enabled: true
    notifications:
      enabled: true
  room3:
    enabled: true
    ffmpeg:
      inputs:
        - path: rtsp://admin:admin1234@192.168.100.115:554/cam/realmonitor?channel=1&subtype=1
          roles:
            - detect
            - rtmp
    detect:
      width: 1920
      height: 1080
      fps: 15
      enabled: true
    notifications:
      enabled: true
  meeting_room:
    enabled: true
    ffmpeg:
      inputs:
        - path: rtsp://admin:admin1234@192.168.100.111:554/cam/realmonitor?channel=1&subtype=1
          roles:
            - detect
            - rtmp
    detect:
      width: 1920
      height: 1080
      fps: 15
      enabled: true
    notifications:
      enabled: true
  entry:
    enabled: true
    ffmpeg:
      inputs:
        - path: rtsp://admin:admin1234@192.168.100.112:554/cam/realmonitor?channel=1&subtype=1
          roles:
            - detect
            - rtmp
    detect:
      width: 1920
      height: 1080
      fps: 15
      enabled: true

    # Define zones for the camera
    zones:
      entry_area:
        coordinates: 0.836,0,0.96,0.014,0.889,0.724,0.713,0.582
        objects: person
        inertia: 3
        loitering_time: 0
    onvif:
      host: 192.168.100.112
      port: 80
      user: admin
      password: admin1234
      # PTZ autotracking configuration
      autotracking:
        enabled: true
        # Optional: calibrate the camera on startup (default: false)
        calibrate_on_startup: true
        # Optional: the mode to use for zooming (default: disabled)
        # Options: disabled, absolute, relative
        zooming: absolute
        # Optional: zoom factor (default: 0.3, range: 0.1-0.75)
        zoom_factor: 0.3
        # Optional: list of objects to track (default: all)
        track:
          - person
        # Required: zones that objects must enter before tracking begins
        required_zones:
          - entry_area
        # Optional: ONVIF preset to return to when done tracking (default: home)
        return_preset: home
        # Optional: seconds to wait before returning to preset (default: 10)
        timeout: 10

    notifications:
      enabled: true
  outdoor:
    enabled: true
    ffmpeg:
      inputs:
        - path: rtsp://admin:888888@192.168.100.116:8554/profile0
          roles:
            - detect
            - rtmp
    detect:
      width: 1920
      height: 1080
      fps: 15
      enabled: true
    lpr:
      enabled: true
    record:
      enabled: false # ✅ ضبط برای این دوربین غیرفعال می‌شود

    # تنظیمات زون‌های تشخیص (اختیاری)
    # zones:
    #   front_door:
    #     coordinates: 100,100,300,100,300,300,100,300
    #     objects:
    #       - person

    # تنظیمات اشیا برای تشخیص
    objects:
      track:
        - person
        - car
        - bicycle
        - motorcycle
        - traffic light
        - fire hydrant
        - street sign
        - parking meter
        - truck
        - car
        - dog
        - cat
      filters:
        person:
          min_area: 5000
          max_area: 100000
          threshold: 0.7

    # نمونه دوربین دیگر - کامنت را برداشته و تنظیم کنید
    # camera_2:
    #   enabled: true
    #   ffmpeg:
    #     inputs:
    #       - path: rtsp://username:password@192.168.1.101:554/stream1
    #         roles:
    #           - detect
    #           - record
    #   detect:
    #     width: 1920
    #     height: 1080
    #     fps: 5

    # تنظیمات UI
    motion:
      threshold: 36
      contour_area: 6
      improve_contrast: true
    notifications:
      enabled: true

    # تنظیمات لاگ
    zones:
      test:
        coordinates: 0.722,0.39,0.851,0.426,0.756,0.897,0.566,0.838
        loitering_time: 0
        speed_threshold: 1
        distances: 6,30,6,30
        inertia: 3
    review:
      alerts:
        required_zones: test
logger:
  default: info
  # logs:
  #   frigate.mqtt: debug
version: 0.17-0

notifications:
  enabled: true
  email: mohammad.khedmati2012@gmail.com
semantic_search:
  enabled: false
  model_size: small
face_recognition:
  enabled: true
  model_size: small
lpr:
  enabled: true
classification:
  bird:
    enabled: false
camera_groups:
  Rooms:
    order: 1
    icon: LuPersonStanding
    cameras:
      - room3
      - room2
      - room1
